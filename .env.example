# Service areas shown across the site. Comma-separated.
# Each name generates its own landing page (/sell-scrap-in-<name>), structured
# data, sitemap entry and footer link — no code changes needed to add a city.
#
# These are public page content, not secrets. Set the same value in
# Vercel → Settings → Environment Variables and redeploy to publish a new area.
VITE_SERVICE_AREAS=Arakkonam,Tiruttani,Sholinghur,Vellore
